{% extends "layout.html.j2" %}
{% block title %}{% if story %}{{ story }}{% else %}New story{% endif %}{% endblock %}
{% block content %}
<h1>
  {% if story %}<code>{{ story }}</code>{% else %}New story{% endif %}
</h1>

<form method="post"
      action="{{ url_for('save', rel=story) if story else '' }}">
  <textarea class="code" name="body" id="editor" spellcheck="false">{{ text }}</textarea>
  {% if not created and story %}
    <p><button type="submit">Save</button></p>
  {% endif %}
</form>

{% if created or not story %}
<form method="post" id="create-form">
  <input type="hidden" name="body" id="new-body-field" value="{{ text }}">
  <label>Filename (relative to root, e.g. <code>my-story.yaml</code>):
    <input type="text" name="rel_new" placeholder="my-story.yaml" required></label>
  <p><button type="submit">Create story</button></p>
</form>
{% endif %}

{% if errors %}
<div class="errors">
  <strong>Problems found:</strong>
  <ul>{% for error in errors %}<li>{{ error|e }}</li>{% endfor %}</ul>
</div>
{% endif %}

<p><a href="/">Back to stories</a></p>

<script>
var createForm = document.getElementById('create-form');
if (createForm) {
  // send to /create/<filename> chosen by the user
  var relInput = createForm.querySelector('[name=rel_new]');
  var bodyField = createForm.querySelector('#new-body-field');
  if (editor && !bodyField.value) { bodyField.value = editor.value; }
  createForm.action = '/create/' + encodeURIComponent(relInput.value || 'story.yaml');
}
// Autosave: debounce typing, validate via /validate/<rel>, show errors inline.
var editor = document.getElementById('editor');
function relPath() {
  var path = window.location.pathname;
  if (path === '/' || path.indexOf('/edit/') !== 0 && \
      path.indexOf('/save/') !== 0) return null;
  var m = location.pathname.match(/^\/save\/(.*)$/);
  return m ? decodeURIComponent(m[1]) : null;
}
var rel = relPath();
if (rel) {
  var timer = null;
  editor.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () { validateNow(rel, editor.value); }, 900);
  });
}
function validateNow(relPathName, body) {
  var fd = new FormData();
  fd.append('body', body);
  fetch('/validate/' + encodeURIComponent(relPathName), {method: 'POST', body: fd})
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var box = document.querySelector('.errors');
      if (!box && data.errors.length) {
        box = document.createElement('div');
        box.className = 'errors';
        editor.parentNode.insertBefore(box, editor);
      }
      if (box) {
        box.innerHTML = '<strong>Problems found:</strong><ul>' +
          data.errors.map(function (e) { return '<li>' + e + '</li>'; }).join('') +
          '</ul>';
        if (!data.errors.length) box.style.display = 'none';
      }
    });
}
</script>
{% endblock %}
