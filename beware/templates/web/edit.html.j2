{% extends "layout.html.j2" %}
{% block title %}{% if story %}{{ story }}{% else %}New story{% endif %} &middot; raw{% endblock %}
{% block head %}
<style>
  textarea.code {
    width: 100%; height: 70vh; resize: vertical;
    font-size: .85rem; line-height: 1.45;
    background: var(--grey-2); color: var(--ink);
    border: 1px solid var(--line); border-radius: 6px;
    padding: .6rem .8rem; tab-size: 4;
  }
  textarea.code:focus { border-color: var(--pink); box-shadow: 0 0 0 3px rgba(255,110,199,.25); }
  .raw-note { color: var(--ink-faint); font-size: .85rem; }
</style>
{% endblock %}
{% block content %}
<h1>
  {% if story %}<code>{{ story }}</code>{% else %}New story (raw yaml){% endif %}
</h1>
<p class="raw-note">
  Raw yaml editing &mdash;
  {% if story %}
    <a href="{{ url_for('edit', rel=story) }}">back to the section studio</a>
  {% else %}
    <a href="{{ url_for('new_story_form') }}">use the section studio instead</a>
  {% endif %}
</p>

{% if errors %}
<div class="problems panel" role="alert" aria-atomic="true">
  <strong>Problems found:</strong>
  <ul>{% for error in errors %}<li>{{ error|e }}</li>{% endfor %}</ul>
</div>
{% endif %}

{% if story and not created %}
<form method="post" action="{{ url_for('save', rel=story) }}">
  <label class="raw-note" for="editor">yaml source of {{ story }}</label>
  <textarea class="code" name="body" id="editor" spellcheck="false">{{ text }}</textarea>
  <p><button type="submit">Save</button></p>
</form>
{% else %}
<form method="post" id="create-form" action="/create/story.yaml">
  <label class="raw-note" for="editor">yaml source of the new story</label>
  <textarea class="code" name="body" id="editor" spellcheck="false">{{ text }}</textarea>
  <p>
    <label>Filename (relative to root):
      <input type="text" name="rel_new" placeholder="my-story.yaml" required
             style="min-width:20em">
    </label>
    <button type="submit">Create story</button>
  </p>
</form>
{% endif %}

<script>
// point the create form at whichever filename the user typed
var createForm = document.getElementById('create-form');
if (createForm) {
  var relInput = createForm.querySelector('[name=rel_new]');
  createForm.addEventListener('submit', function () {
    var name = relInput.value || 'story.yaml';
    createForm.action = '/create/' + encodeURIComponent(name);
  });
}
// autosave validation for existing files
var editor = document.getElementById('editor');
var m = location.pathname.match(/^\/raw\/(.*)$/);
var rel = m ? decodeURIComponent(m[1]) : null;
if (rel && editor) {
  var timer = null;
  editor.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () { validateNow(rel, editor.value); }, 900);
  });
}
function validateNow(relName, body) {
  var fd = new FormData();
  fd.append('body', body);
  fetch('/validate/' + encodeURIComponent(relName), {method: 'POST', body: fd})
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var box = document.querySelector('.problems');
      if (!box && data.errors.length) {
        box = document.createElement('div');
        box.className = 'problems panel';
        // the created node is a live-region announcement, not just ink
        box.setAttribute('role', 'alert');
        box.setAttribute('aria-atomic', 'true');
        editor.parentNode.insertBefore(box, editor);
      }
      if (box) {
        var count = data.errors.length;
        box.innerHTML = '<strong>Problems found:</strong><ul>' +
          data.errors.map(function (e) { return '<li>' + e + '</li>'; }).join('') +
          '</ul>';
        // the list alone is silent to assistive tech once hidden
        box.setAttribute('aria-label',
          count ? count + ' problems found in this yaml' : '');
        box.style.display = count ? '' : 'none';
      }
    });
}
</script>
{% endblock %}
